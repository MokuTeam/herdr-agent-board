{
  "name": "agent-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "herdr plugin: kanban of Claude sessions with categories set by the agents themselves",
  "scripts": {
    "board": "bun src/entrypoints/tui.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test",
    "format": "biome check --write src test",
    "check": "bun run typecheck && bun run lint"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
