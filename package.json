{
  "name": "agent-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "herdr plugin: kanban of Claude sessions with categories set by the agents themselves",
  "scripts": {
    "board": "bun src/entrypoints/tui.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test web/src hub",
    "format": "biome check --write src test web/src hub",
    "check": "bun run typecheck && bun run lint"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "optionalDependencies": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.3",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@napi-rs/canvas": "file:./packages/no-canvas"
  }
}
